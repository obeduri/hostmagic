{
  "name": "hostmagic",
  "version": "1.0.0",
  "description": "Automate local fullstack dev with .local domains, random ephemeral ports, and concurrent execution",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "hostmagic": "./dist/cli.js",
    "hm": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test/core.test.ts && bun test/detector.test.ts && bun test/proxy.test.ts && bun test/killer.test.ts && bun test/platform.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "fullstack",
    "hosts",
    "local-domains",
    "development",
    "concurrent",
    "ports"
  ],
  "author": "Obed David Pérez Uri <enobe220@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obeduri/hostmagic.git"
  },
  "homepage": "https://github.com/obeduri/hostmagic#readme",
  "bugs": {
    "url": "https://github.com/obeduri/hostmagic/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^12.1.0",
    "execa": "^9.4.1",
    "get-port": "^7.1.0",
    "http-proxy": "^1.18.1",
    "picocolors": "^1.1.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.5.5",
    "selfsigned": "^5.5.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}
